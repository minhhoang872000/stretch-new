# ─── Instructor console — environment ────────────────────────────────
# Copy to `.env` (or `.env.local`) and adjust. Only VITE_* vars reach the
# browser bundle — never put a secret here.

# Base URL of lead-tracker-api, including the version prefix, no trailing slash.
# Local:      http://localhost:3001/api/v1
# Production: https://<your-api-host>/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1
