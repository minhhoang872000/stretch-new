# ─── Public site (Nuxt on Cloudflare Pages) — environment variables ──────────
# Copy to `.env` for local dev. In production set these in the Cloudflare Pages
# dashboard (Settings → Environment variables); `.env` is not deployed.

NUXT_PUBLIC_SITE_URL=https://stretch.vn
NUXT_PUBLIC_TRACKING_API_URL=

# ─── Sign in with Google (nuxt-auth-utils) ───────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials → Create OAuth client (Web).
#    Authorized redirect URIs — one per domain the site runs on:
#      http://localhost:3000/api/auth/google
#      https://stretch.vn/api/auth/google
# 2. OAuth consent screen → Publishing status must be "In production". While it
#    is "Testing" only the listed test users can sign in; everyone else gets
#    "Access blocked".
# 3. NUXT_SESSION_PASSWORD seals the session cookie — any random string of at
#    least 32 characters (e.g. `openssl rand -hex 32`).
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# ─── Learner API (lead-tracker-api) ──────────────────────────────────────────
# Base URL of the API, WITH the /api/v1 suffix. Local dev: http://localhost:3001/api/v1
NUXT_LESSON_API_BASE=
# Shared secret sent as `x-service-token`. Must equal SITE_SERVICE_TOKEN in the
# API's environment; without it Google sign-in succeeds but no learner is
# attached to the session (courses / checkout look empty).
NUXT_SITE_SERVICE_TOKEN=

# ─── EmailJS (booking confirmation mails) ────────────────────────────────────
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NUXT_PUBLIC_EMAILJS_ADMIN_TEMPLATE_ID=
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ─── Bank-transfer checkout (VietQR) ─────────────────────────────────────────
# Bank code per https://api.vietqr.io/v2/banks (e.g. VCB, TCB, MB).
NUXT_PUBLIC_BANK_CODE=
NUXT_PUBLIC_BANK_ACCOUNT=
NUXT_PUBLIC_BANK_ACCOUNT_NAME=
