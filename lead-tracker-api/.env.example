# ─── Lead Tracker API — environment variables ───────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).

NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL / Supabase) ────────────────────────────────
# Prefer DATABASE_URL if your host injects one; otherwise set the parts below.
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# ─── CORS (comma-separated frontend origins) ─────────────────────────
# 5173 = restorative-crm, 5180 = instructor-admin. Any localhost origin is
# accepted while NODE_ENV != production; this list is what production enforces.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5180

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
# Anonymous callers (public site, and whoever else finds the URL).
RATE_LIMIT_MAX=120
# Callers presenting a token. Far higher on purpose: an admin console screen
# loads several collections, and a person clicking through it is not abuse.
RATE_LIMIT_AUTH_MAX=1200

# ─── Authentication (JWT) ────────────────────────────────────────────
# REQUIRED in production — the app refuses to start with the default values.
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Admin

# ─── Google Analytics 4 (service account) ────────────────────────────
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# ─── Google Search Console (Search Analytics API) ────────────────────
# Reuses the GA service account by default — only set the *_CLIENT_EMAIL /
# *_PRIVATE_KEY below to override. Two one-time setup steps required:
#   1. Add the service-account email as a USER on the GSC property.
#   2. Enable the "Google Search Console API" in the GCP project.
# Domain property → keep the sc-domain: prefix (NOT https://…).
GSC_SITE_URL=sc-domain:stretch.vn
# GSC_CLIENT_EMAIL=   # defaults to GA_CLIENT_EMAIL
# GSC_PRIVATE_KEY=    # defaults to GA_PRIVATE_KEY

# ─── Cloudflare R2 (image uploads, S3-compatible) ────────────────────
# Account ID = the 32-char hex in the dashboard URL (dash.cloudflare.com/<this>/...)
R2_ACCOUNT_ID=
# R2 → Manage R2 API Tokens → Create (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL (no trailing slash): pub-<hash>.r2.dev or a custom domain
R2_PUBLIC_BASE_URL=
R2_PREFIX=blog
R2_MAX_BYTES=10485760

# ─── Lesson videos in R2 (private bucket — do NOT expose via R2_PUBLIC_BASE_URL) ───
# Separate PRIVATE bucket for lecture videos. Do not reuse the image bucket:
# that one is public through R2_PUBLIC_BASE_URL, which would defeat signed playback.
#
# The console uploads from the browser straight to this bucket, so the bucket
# needs its own CORS policy. Without ExposeHeaders: ["ETag"] the browser reads
# null for every part ETag and CompleteMultipartUpload rejects the part list —
# the client then falls back to one slow PUT. The policy lives in
# `r2-video-cors.json`; apply it with either:
#   npx wrangler r2 bucket cors set <bucket> --file r2-video-cors.json
#   npx wrangler r2 bucket cors list <bucket>          # verify
# or paste it in R2 → bucket → Settings → CORS Policy → Add CORS policy → JSON.
R2_VIDEO_BUCKET=stretch-course-video
# Key prefix for lecture videos inside the video bucket.
R2_VIDEO_PREFIX=lessons
# Largest single upload accepted (bytes). Default 3 GB.
R2_VIDEO_MAX_BYTES=3221225472
# Multipart part size (bytes). R2 requires >= 5 MB for every part but the last.
R2_VIDEO_PART_SIZE=16777216
# Cap on presigned part URLs handed out per upload (raises part size for huge files).
R2_VIDEO_MAX_PARTS=400
# How long a presigned part URL stays valid (seconds).
R2_VIDEO_UPLOAD_TTL=7200
# How long a playback URL stays valid (seconds). Keep it near one lesson's length.
R2_VIDEO_PLAYBACK_TTL=1800

# Shared secret the website's server routes send as `x-service-token` to request
# playback URLs after they have checked the learner's session/enrolment.
SITE_SERVICE_TOKEN=

# ─── Google Calendar (1-to-1 mentorship sessions) ────────────────────
# Reuses the GA service account by default. Two one-time setup steps:
#   1. Enable the "Google Calendar API" in the same GCP project.
#   2. Open Google Calendar as the account below → Settings → Share with
#      specific people → add the SERVICE-ACCOUNT email (GA_CLIENT_EMAIL) with
#      "Make changes to events". Without this, every call returns 404/403.
#
# Which calendar accepted sessions are written to.
GCAL_CALENDAR_ID=admin@stretch.vn
# GCAL_CLIENT_EMAIL=   # defaults to GA_CLIENT_EMAIL
# GCAL_PRIVATE_KEY=    # defaults to GA_PRIVATE_KEY
#
# GOOGLE MEET LINKS AND EMAIL INVITATIONS — Workspace only.
# A bare service account may create events but may NOT invite attendees or mint
# a Meet link; Google rejects both. To get them, the service account has to act
# AS a real user (domain-wide delegation), which requires Google Workspace:
#   1. GCP → the service account → enable "Domain-wide delegation", copy its
#      Client ID.
#   2. Workspace Admin → Security → API controls → Domain-wide delegation → add
#      that Client ID with scope https://www.googleapis.com/auth/calendar
#   3. Set the line below to the user to act as.
# Left empty, sessions are still scheduled — just with no Meet link, and the
# console shows a box to paste one in by hand.
GCAL_IMPERSONATE_SUBJECT=
# Vietnam has no DST, so the fixed offset is correct year-round.
GCAL_TIMEZONE=Asia/Ho_Chi_Minh
GCAL_UTC_OFFSET=+07:00

# ─── 1-to-1 mentorship booking rules ─────────────────────────────────
# Length of one session. Must divide the opening hours evenly.
MENTORSHIP_SLOT_MINUTES=30
# How far ahead a learner may book.
MENTORSHIP_BOOK_AHEAD_DAYS=14
# Refuse slots starting sooner than this, so nobody books 10 minutes out.
MENTORSHIP_LEAD_TIME_HOURS=12
# Open requests one learner may hold at once.
MENTORSHIP_MAX_PENDING=2

# Public site URL — used to link a calendar event back to the lesson.
SITE_BASE_URL=https://stretch.vn
