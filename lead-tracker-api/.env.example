# Server
PORT=3001
NODE_ENV=development

# PostgreSQL Database
# Option 1: Connection string (recommended — Render injects this automatically)
# DATABASE_URL=postgresql://user:password@host:5432/lead_tracker?sslmode=require

# Option 2: Individual credentials (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=lead_tracker

# If your PostgreSQL provider uses SSL (Render, Supabase, Neon, etc.)
DB_SSL=false

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
