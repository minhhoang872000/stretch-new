# ─── Lead Tracker API — environment variables ───────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).

NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL / Supabase) ────────────────────────────────
# Prefer DATABASE_URL if your host injects one; otherwise set the parts below.
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# ─── CORS (comma-separated frontend origins) ─────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ─── Authentication (JWT) ────────────────────────────────────────────
# REQUIRED in production — the app refuses to start with the default values.
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Admin

# ─── Google Analytics 4 (service account) ────────────────────────────
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# ─── Cloudflare R2 (image uploads, S3-compatible) ────────────────────
# Account ID = the 32-char hex in the dashboard URL (dash.cloudflare.com/<this>/...)
R2_ACCOUNT_ID=
# R2 → Manage R2 API Tokens → Create (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL (no trailing slash): pub-<hash>.r2.dev or a custom domain
R2_PUBLIC_BASE_URL=
R2_PREFIX=blog
R2_MAX_BYTES=10485760
