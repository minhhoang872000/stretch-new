# Server
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────
# Option 1: Connection string (recommended — Supabase, Render, Neon, etc.)
# Get this from Supabase Dashboard → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Option 2: Individual credentials (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=lead_tracker

# If your PostgreSQL provider uses SSL (Supabase, Render, Neon, etc.)
DB_SSL=false

# ─── Supabase (optional — for future Supabase client SDK usage) ───────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ─── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── Rate Limit ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
