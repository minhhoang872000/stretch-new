# Server
PORT=3001
NODE_ENV=development

# MySQL Database
# For PlanetScale / Aiven / Railway — use the connection string they provide
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=lead_tracker

# If your MySQL provider uses SSL (PlanetScale, Aiven, etc.)
DB_SSL=false

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
